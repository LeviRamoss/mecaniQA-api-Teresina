          "name": "1. Criar peça",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoBarras\": \"789000000001\",\n  \"fornecedorMarca\": \"Bosch\",\n  \"quantidadeEstoque\": 10,\n  \"precoCusto\": 80.5,\n  \"precoVenda\": 129.9,\n  \"tamanho\": null,\n  \"cor\": null,\n  \"categoria\": \"ELETRICA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pecas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pecas"
              ]
            }
          }
        },
        {
          "name": "2. Listar peças",
          "request": {
            "method": "GET",
            "url": {
